From 8e8cbb840aa0db89bca01d886bc4e125f3d6a2c7 Mon Sep 17 00:00:00 2001
From: Kir Kolyshkin <kolyshkin@gmail.com>
Date: Wed, 21 Oct 2026 13:18:17 -0700
Subject: [PATCH 2/2] container: delete: drop EINVAL check after kill

Since the previous commit, libcrun_kill_linux maps EINVAL (and ENOENT)
from pidfd_open to ESRCH, so there is no need to check for it here.

Assisted-by: Claude Code (claude-opus-5-5)
Signed-off-by: Kir Kolyshkin <kolyshkin@gmail.com>
---
 src/libcrun/container.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/src/libcrun/container.c b/src/libcrun/container.c
index 98264d1b..f86ec3e4 100644
--- a/src/libcrun/container.c
+++ b/src/libcrun/container.c
@@ -1609,11 +1609,7 @@ container_delete_internal (libcrun_context_t *context, runtime_spec_schema_confi
           ret = libcrun_kill_linux (&status, SIGKILL, err);
           if (UNLIKELY (ret < 0))
             {
-              errno = crun_error_get_errno (err);
-
-              /* pidfd_open returns EINVAL if the process is not a thread-group leader.
-                 In our case it means the process already exited, so handle as ESRCH.  */
-              if (errno != ESRCH && errno != EINVAL)
+              if (crun_error_get_errno (err) != ESRCH)
                 return ret;
 
               crun_error_release (err);
-- 
